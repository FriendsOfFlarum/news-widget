{
    "name": "fof/news-widget",
    "description": "Simple news fader widget",
    "keywords": [
        "flarum", "widget", "news", "forum"
    ],
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://friendsofflarum.org",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/news-widget/issues",
        "source": "https://github.com/FriendsOfFlarum/news-widget",
        "forum": "https://discuss.flarum.org/d/39068"
    },
    "replace": {
        "afrux/news-widget": "*"
    },
    "require": {
        "flarum/core": "^1.8.0",
        "fof/forum-widgets-core": "^1.0.0"
    },
    "require-dev": {
        "flarum/phpstan": "*"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\News\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\News\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "flarum-extension": {
            "title": "FoF News Widget",
            "category": "forum-widget",
            "icon": {
                "name": "fas fa-bullhorn",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
